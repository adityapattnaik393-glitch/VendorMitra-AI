# ─── IBM watsonx.ai (Granite) ────────────────────────────────────────────────
# Obtain from https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_api_key_here

# watsonx.ai project ID — from the project settings page
IBM_PROJECT_ID=your_watsonx_project_id_here

# Deployment region: us-south | eu-de | eu-gb | jp-tok | au-syd | ca-tor
IBM_REGION=us-south

# Optional. Run `python -m app.check_granite` to list chat models in your region.
IBM_MODEL_ID=ibm/granite-4-h-small
